# --- Prompt helpers --------------------------------------------------------

def prompt(text, default=""):
    hint = f" {C_DIM}[default: {default}]{C_RESET}" if default else ""
    raw = input(
        f"{C_BOLD}{C_BLUE}?[{C_RESET} {C_BOLD}{text}{C_RESET}{hint}\n"
        f" {C_CYAN}➔{C_RESET} "
    ).strip()
    return raw if raw else default


def parse_bool(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    return "true" if value.lower() in ("true", "y", "yes", "1") else "false"


def parse_list(value, default_list):
    """Return a TOML-compatible list literal."""
    if not value.strip():
        items = list(default_list)
    else:
        items = [item.strip() for item in value.split(",") if item.strip()]
    return "[" + ", ".join(f'"{item}"' for item in items) + "]"


# --- Environment checks ----------------------------------------------------

def require_root():
    """Abort early unless pwnygen is running with root privileges."""
    if os.geteuid() != 0:
        print(f"{C_RED}{C_BOLD}✖  Error:{C_RESET} pwnygen must be run as root.")
        print(f"   Please run: {C_YELLOW}{C_BOLD}sudo pwnygen{C_RESET}")
        sys.exit(1)


def _dpkg_installed(pkg):
    return os.system(f"dpkg -s {pkg} >/dev/null 2>&1") == 0


def pisugar_present():
    """Return True only if pisugar-server / pisugar-poweroff are really installed.

    We deliberately do not rely on systemd unit files: a masked or leftover
    unit can survive ``dpkg --purge`` and would give a false positive.
    """
    if _dpkg_installed("pisugar-server") or _dpkg_installed("pisugar-poweroff"):
        return True
    for path in (
        "/usr/bin/pisugar-server", "/usr/local/bin/pisugar-server",
        "/usr/bin/pisugar-poweroff", "/usr/local/bin/pisugar-poweroff",
    ):
        if os.path.exists(path):
            return True
    return False


def install_pisugar_packages():
    """Install bundled pisugar .deb files from the local image (offline)."""
    if not os.path.isdir(PACKAGES_DIR):
        print(f"{C_RED}✖  Packages dir not found: {PACKAGES_DIR}{C_RESET}")
        return

    debs = sorted(
        os.path.join(PACKAGES_DIR, name)
        for name in os.listdir(PACKAGES_DIR)
        if name.startswith(("pisugar-server", "pisugar-poweroff")) and name.endswith(".deb")
    )
    if not debs:
        print(f"{C_RED}✖  No PiSugar .deb files found in {PACKAGES_DIR}{C_RESET}")
        return

    for deb in debs:
        print(f"{C_CYAN}➔ Installing {os.path.basename(deb)} ...{C_RESET}")
        rc = os.system(f"dpkg -i '{deb}'")
        if rc != 0:
            print(f"{C_YELLOW}⚠  dpkg reported an issue, trying to fix deps (offline)...{C_RESET}")
            os.system("apt-get install -f -y")


# --- Wizard ----------------------------------------------------------------

def collect_answers():
    """Run the interactive questionnaire and return a plain dict of answers."""
    answers = {}

    answers["name"] = prompt("Pet's name?", "pwnagotchi")
    answers["iface"] = prompt("Wi-Fi monitor interface?", "wlan0mon")

    # Kept as-is on purpose: legacy default unchanged.
    answers["home_networks"] = prompt(
        "Home Wi-Fi SSIDs/MACs (comma separated)?",
        "MyHomeWiFi, aa:bb:cc:dd:ee:ff",
    )
    answers["whitelist"] = prompt("Ignored APs / Whitelist (comma separated)?", "")

    answers["watchdog_max_blind_epochs"] = prompt(
        "Reboot after how many blind epochs without interface loss?",
        "15",
    )

    answers["ai_enabled"] = prompt("Enable AI brain (y/n)?", "y")
    answers["grid_enabled"] = prompt("Enable Grid reporting (y/n)?", "y")

    answers["display_enabled"] = prompt("Enable physical screen (y/n)?", "y")
    answers["display_type"] = prompt("Screen model?", "waveshare_4")
    answers["ui_invert"] = prompt("Invert screen colors (y/n)?", "n")
    answers["ui_fps"] = prompt("Screen refresh FPS?", "0.0")

    answers["web_auth"] = parse_bool(prompt("Password-protect Web UI (y/n)?", "n")) == "true"
    if answers["web_auth"]:
        answers["web_username"] = prompt("Web UI username?", "changeme")
        answers["web_password"] = prompt("Web UI password?", "changeme")
    else:
        answers["web_username"] = "changeme"
        answers["web_password"] = "changeme"

    answers["bt_pan"] = prompt("Bluetooth Tethering (y/n)?", "n")

    pisugar_enabled = parse_bool(prompt("Do you have a PiSugar battery board (y/n)?", "n")) == "true"
    answers["pisugar_enabled"] = pisugar_enabled

    if pisugar_enabled:
        dt_enabled = parse_bool(prompt("Enable datetime on screen (y/n)?", "n")) == "true"
        if dt_enabled:
            answers["datetime_format"] = prompt("Datetime format?", "%H:%M %d-%m")
        else:
            answers["datetime_format"] = "%H:%M %d-%m"
        answers["datetime_enabled"] = dt_enabled
    else:
        answers["datetime_enabled"] = False
        answers["datetime_format"] = "%H:%M %d-%m"

    return answers


def render_config(answers):
    return BASE_CONFIG_TEMPLATE.format(
        main_name=answers["name"],
        main_iface=answers["iface"],
        main_home_networks=parse_list(
            answers["home_networks"],
            ["MyHomeWiFi", "aa:bb:cc:dd:ee:ff"],
        ),
        main_whitelist=parse_list(answers["whitelist"], []),
        ai_enabled=parse_bool(answers["ai_enabled"]),
        grid_enabled=parse_bool(answers["grid_enabled"]),
        ui_display_enabled=parse_bool(answers["display_enabled"]),
        ui_display_type=answers["display_type"],
        ui_invert=parse_bool(answers["ui_invert"]),
        ui_fps=answers["ui_fps"],
        ui_web_auth=parse_bool(answers["web_auth"]),
        ui_web_username=answers["web_username"],
        ui_web_password=answers["web_password"],
        bt_pan_enabled=parse_bool(answers["bt_pan"]),
        watchdog_max_blind_epochs=answers["watchdog_max_blind_epochs"],
        pisugarx_enabled="true" if answers["pisugar_enabled"] else "false",
        datetime_enabled="true" if answers["datetime_enabled"] else "false",
        datetime_format=answers["datetime_format"],
    )


def write_config(content):
    try:
        with open(CONFIG_PATH, "w") as fp:
            fp.write(content)
        print(f"\n{C_GREEN}{C_BOLD}✔  Success:{C_RESET} {CONFIG_PATH} successfully updated!")
        return True
    except PermissionError:
        print(
            f"\n{C_RED}{C_BOLD}✖  Error:{C_RESET} Permission denied. "
            f"Please run with sudo: {C_YELLOW}sudo pwnygen{C_RESET}"
        )
    except OSError as exc:
        print(f"\n{C_RED}{C_BOLD}✖  Error writing file:{C_RESET} {exc}")
    return False


def main():
    require_root()
    os.system("clear" if os.name == "posix" else "cls")
    print(BANNER)

    try:
        answers = collect_answers()
    except (KeyboardInterrupt, EOFError):
        print(f"\n{C_MAGENTA}Aborted.{C_RESET}")
        sys.exit(130)

    generated_config = render_config(answers)

    print(f"\n{C_YELLOW}{C_BOLD}Configuration generation complete!{C_RESET}")
    confirm = prompt(
        f"{C_RED}{C_BOLD}Overwrite {CONFIG_PATH}? (y/n){C_RESET}",
        "no",
    ).strip().lower()

    if not confirm.startswith("y"):
        print(f"\n{C_MAGENTA}Aborted. No changes were made.{C_RESET}")
        return

    if not write_config(generated_config):
        return

    if answers["pisugar_enabled"]:
        if pisugar_present():
            print(f"\n{C_GREEN}✔  PiSugar already installed — skipping .deb install.{C_RESET}")
        else:
            print(f"\n{C_CYAN}➔ Installing PiSugar packages from local image...{C_RESET}")
            install_pisugar_packages()


if __name__ == "__main__":
    main()

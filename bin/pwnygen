#!/usr/bin/env python3
"""pwnygen - interactive /etc/pwnagotchi/config.toml generator."""

import os
import sys


# --- ANSI styling -----------------------------------------------------------

C_CYAN    = "\033[96m"
C_GREEN   = "\033[92m"
C_YELLOW  = "\033[93m"
C_RED     = "\033[91m"
C_MAGENTA = "\033[95m"
C_BLUE    = "\033[94m"
C_BOLD    = "\033[1m"
C_DIM     = "\033[2m"
C_RESET   = "\033[0m"

BANNER = (
    f"{C_CYAN}{C_BOLD}\n"
    f"  (◕‿‿◕)  PWNYGEN\n"
    f"  ---------------------------------\n"
    f"  Interactive config.toml generator\n"
    f"{C_RESET}"
)

# Directory holding the pre-bundled .deb packages shipped inside the image.
PACKAGES_DIR = "/usr/local/share/pwnagotchi/packages"

# Path written on success.
CONFIG_PATH = "/etc/pwnagotchi/config.toml"


# --- Template --------------------------------------------------------------

BASE_CONFIG_TEMPLATE = """[main]

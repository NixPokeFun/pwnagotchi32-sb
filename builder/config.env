# ---------------------------------------------------------------------------
#  Builder configuration. Do not edit per machine: put overrides in
#  config.local.env (git-ignored) or pass --config FILE / CLI flags.
# ---------------------------------------------------------------------------

# ---- base image: Raspberry Pi OS Lite, Debian 11 "bullseye", 32-bit -----------
# 2023-05-03 is the last bullseye image (kernel 6.1.21), the one the nexmon
# driver in brcm/ is built for.
BASE_IMAGE_URL="https://downloads.raspberrypi.org/raspios_lite_armhf/images/raspios_lite_armhf-2023-05-03/2023-05-03-raspios-bullseye-armhf-lite.img.xz"
BASE_IMAGE_SHA256=""        # empty: fetched from "${BASE_IMAGE_URL}.sha256"

# ---- output ---------------------------------------------------------------------
IMAGE_NAME="pwnagotchi-ai32"
IMAGE_VERSION=""            # empty: read from pwnagotchi/_version.py
EXTRA_SIZE_MB=3072          # grow the image before building (torch, nexmon, ...)
COMPRESS="xz"               # xz | none
ZERO_FREE_SPACE=0           # 1: zero-fill free space first (slower, smaller .xz)

# ---- directories (empty: builder/work, builder/out, builder/cache) -----------------
WORK_DIR=""                 # working image + mount points (use a Linux path, not /mnt/d)
OUT_DIR=""                  # finished images
CACHE_DIR=""                # downloads (base image, artifacts)

# ---- target system ------------------------------------------------------------------
TARGET_HOSTNAME="pwnagotchi"
CREATE_USER=1
TARGET_USER="pi"
TARGET_PASSWORD="raspberry" # CHANGE ME in config.local.env
ENABLE_SERVICES="bettercap pwngrid-peer pwnagotchi"
DISABLE_SERVICES=""
PRUNE_UNUSED_KERNELS=1      # drop v7/v7l/v8 kernels, headers and boot files (Pi Zero W only)
KERNEL_RELEASE=""           # empty: auto-detect (the "...+" armv6 kernel)

# ---- artifacts ------------------------------------------------------------------------
INSTALL_BUNDLED_SHA=1       # also install the *.sha256 packed next to a binary, next to the installed binary

# ---- scripts copied from repo bin/ to /usr/local/bin as-is (not via pip) ---------------
EXTRA_BIN="pwnygen"

# ---- packages -----------------------------------------------------------------------
ALLOW_KERNEL_CHANGE=0       # 1: do not abort if apt changes raspberrypi-kernel (breaks nexmon)
INSTALL_LOCAL_DEBS=1        # install assets/packages/*.deb (pisugar)
APT_SOURCES_FILE=""         # optional sources.list to use instead of the image's
PIP_PIN="pip==24.0 setuptools==69.2.0 wheel==0.43.0"

# ---- emulation ----------------------------------------------------------------------
QEMU_CPU="arm1176"          # Pi Zero CPU; empty = qemu default

# ---- docker -------------------------------------------------------------------------
DOCKER_IMAGE="pwnagotchi-ai32-builder"
